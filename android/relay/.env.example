# Public DNS name that follows this folder when the VPS changes.
COUCO_DOMAIN=coucou-relay.example.com

# portable: Caddy in this folder owns ports 80/443 and obtains TLS itself.
# existing-proxy: the relay binds to 127.0.0.1:8787 for an existing Nginx/Caddy.
COUCO_MODE=portable

COUCO_CONNECTS_PER_MINUTE=60

# Installer used inside generated one-click Windows client packages.
COUCO_WINDOWS_INSTALLER_URL=https://github.com/Araujoatleta/Agent-Zhyon/releases/download/windows-latest/Coucou-Windows-setup.exe

