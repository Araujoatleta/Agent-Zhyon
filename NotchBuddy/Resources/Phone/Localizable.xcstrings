{
  "sourceLanguage": "en",
  "strings": {
    "%@ Sign in to iCloud with the same account as your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Inicia sesión en iCloud con la misma cuenta que tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Connectez-vous à iCloud avec le même compte que votre Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Inicie sessão no iCloud com a mesma conta do seu Mac."
          }
        }
      }
    },
    "%@ asks to run": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pide ejecutar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande à exécuter"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pede para executar"
          }
        }
      }
    },
    "%@ can't be reached, at home or through Tailscale. Is Tailscale on, on this iPhone and on the computer, and the computer awake with the app running?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede alcanzar %@, ni en casa ni por Tailscale. ¿Está Tailscale activado en este iPhone y en el ordenador, y el ordenador despierto con la app abierta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est injoignable, à la maison comme par Tailscale. Tailscale est-il activé sur cet iPhone et sur l'ordinateur, et l'ordinateur réveillé avec l'app ouverte ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alcançar %@, nem em casa nem pelo Tailscale. O Tailscale está ligado neste iPhone e no computador, e o computador está acordado com o app aberto?"
          }
        }
      }
    },
    "%@ didn't answer in time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas répondu à temps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu a tempo."
          }
        }
      }
    },
    "%@ has no key or server address for that brain yet: add it there, in Settings → Hermes Agent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no tiene clave ni dirección de servidor para ese cerebro: añádela allí, en Configuración → Hermes Agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas encore de clé ni d'adresse de serveur pour ce cerveau : ajoutez-la là-bas, dans Réglages → Hermes Agent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda não tem chave nem endereço de servidor para esse cérebro: adicione lá, em Configurações → Hermes Agent."
          }
        }
      }
    },
    "%@ is still busy with the assistant. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue ocupado con el asistente. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est encore occupé avec l'assistant. Réessayez dans un instant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda está ocupado com o assistente. Tente de novo em instantes."
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld arquivos"
          }
        }
      }
    },
    "%lld free resets": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld reinicios gratuitos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld réinitialisations gratuites"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld redefinições grátis"
          }
        }
      }
    },
    "%lld steps · show all": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pasos · mostrar todos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld étapes · tout afficher"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld passos · mostrar todos"
          }
        }
      }
    },
