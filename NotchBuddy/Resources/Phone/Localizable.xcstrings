          }
        }
      }
    },
    "Coucou on iPhone shows what Claude Code and Mochi are doing on your Windows or Linux computer, and answers their requests. Three things to set up, once.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou en el iPhone muestra lo que Claude Code y Mochi están haciendo en tu ordenador Windows o Linux, y responde a sus solicitudes. Tres cosas que configurar, una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou sur iPhone montre ce que Claude Code et Mochi font sur votre ordinateur Windows ou Linux, et répond à leurs demandes. Trois choses à régler, une seule fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Coucou no iPhone mostra o que o Claude Code e o Mochi estão fazendo no seu computador Windows ou Linux, e responde aos pedidos deles. Três coisas para configurar, uma vez só."
          }
        }
      }
    },
