    "Calm, courteous and quietly witty, like a seasoned butler who is also an engineer: the next step anticipated and offered in one line.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranquilo, cortés y discretamente ingenioso, como un mayordomo experto que también es ingeniero: anticipa el siguiente paso y lo ofrece en una línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme, courtois et discrètement spirituel, comme un majordome chevronné qui serait aussi ingénieur : l'étape suivante anticipée et proposée en une ligne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo, cortês e discretamente espirituoso, como um mordomo experiente que também é engenheiro: antecipa o próximo passo e o oferece em uma linha."
          }
        }
      }
    },
