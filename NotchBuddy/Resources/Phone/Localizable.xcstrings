        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no iCloud com a mesma Conta Apple nos dois. Suas sessões passam pelo seu iCloud privado, criptografadas."
          }
        }
      }
    },
