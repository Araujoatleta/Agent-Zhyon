            "state": "translated",
            "value": "Ouvrir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir"
          }
        }
      }
    },
    "Open AXYON once at home with your computer on: it gives this iPhone your positions and ceilings. Or tell AXYON in the chat what you hold.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AXYON una vez en casa con el ordenador encendido: le pasa a este iPhone tus posiciones y techos. O dile a AXYON en el chat lo que tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AXYON une fois à la maison avec l'ordinateur allumé : il donne à cet iPhone vos positions et vos plafonds. Ou dites à AXYON dans le chat ce que vous détenez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o AXYON uma vez em casa com o computador ligado: ele passa para este iPhone as suas posições e tetos. Ou conte ao AXYON no chat o que você tem."
          }
        }
      }
    },
