    "To": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até"
          }
        }
      }
    },
    "To see the files it changed, turn on Settings → Phone → “Show the files an agent changed on the phone” on %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver los archivos que cambió, activa Configuración → Teléfono → “Mostrar en el teléfono los archivos que un agente ha cambiado” en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir les fichiers qu'il a modifiés, activez Réglages → Téléphone → « Afficher sur le téléphone les fichiers qu'un agent a modifiés » sur %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver os arquivos que ele alterou, ative Configurações → Celular → “Mostrar no celular os arquivos que um agente alterou” em %@."
          }
        }
      }
    },
    "To sign out, use Coucou → Settings → Hermes Agent on the computer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cerrar sesión, usa Coucou → Configuración → Hermes Agent en el ordenador."
          }
        },
