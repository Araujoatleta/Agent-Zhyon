    "This QR code isn't a Coucou pairing code. Use the one in Settings → Phone (Android and iPhone) on the computer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR no es un código de vinculación de Coucou. Usa el de Configuración → Teléfono (Android y iPhone) en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR code n'est pas un code de jumelage Coucou. Utilisez celui de Réglages → Téléphone (Android et iPhone) sur l'ordinateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
