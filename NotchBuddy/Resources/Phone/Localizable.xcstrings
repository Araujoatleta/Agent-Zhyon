    "Warm and friendly, like a helpful friend: short, clear answers, a light touch of humour when it fits.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cálido y amable, como un amigo servicial: respuestas cortas y claras, con un toque de humor cuando encaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaleureux et amical, comme un ami serviable : des réponses courtes et claires, une pointe d'humour quand ça s'y prête."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caloroso e amigável, como um amigo prestativo: respostas curtas e claras, com um toque leve de humor quando cabe."
          }
        }
      }
    },
