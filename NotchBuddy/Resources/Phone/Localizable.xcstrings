    "This iPhone will show the agents running on it and answer their permission requests, on your local network only. Allow always asks for Face ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone mostrará los agentes que se ejecutan en él y responderá a sus solicitudes de permiso, solo en tu red local. Permitir siempre pide Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone affichera les agents qui y tournent et répondra à leurs demandes d'autorisation, sur votre réseau local uniquement. Autoriser demande toujours Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone vai mostrar os agentes que rodam nele e responder aos pedidos de permissão deles, só na sua rede local. Permitir sempre pede Face ID."
          }
        }
      }
    },
