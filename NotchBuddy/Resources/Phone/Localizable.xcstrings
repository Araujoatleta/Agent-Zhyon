    "Ask Mochi to do something on %@: look through a folder, change a file, run the tests…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a Mochi que haga algo en %@: revisar una carpeta, cambiar un archivo, ejecutar las pruebas…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à Mochi de faire quelque chose sur %@ : parcourir un dossier, modifier un fichier, lancer les tests…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ao Mochi para fazer algo em %@: olhar uma pasta, mudar um arquivo, rodar os testes…"
          }
        }
      }
    },
