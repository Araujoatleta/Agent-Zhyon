    "Off: Hermes stays installed on the computer, its gateway stops, and its brain and skills can't change from here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: Hermes sigue instalado en el ordenador, su gateway se detiene, y su cerebro y sus habilidades no se pueden cambiar desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : Hermes reste installé sur l'ordinateur, sa passerelle s'arrête, et son cerveau et ses compétences ne se changent plus d'ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado: o Hermes continua instalado no computador, o gateway dele para, e o cérebro e as habilidades não mudam daqui."
          }
        }
      }
    },
