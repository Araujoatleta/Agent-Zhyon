    "Allow": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        }
      }
    },
    "Allow asks for Face ID. The request expires after 2 minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir pide Face ID. La solicitud caduca a los 2 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser demande Face ID. La demande expire au bout de 2 minutes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir pede Face ID. O pedido expira depois de 2 minutos."
          }
        }
      }
    },
    "Allow the camera for Coucou in iPhone Settings, or copy the link on the computer and paste it instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la cámara para Coucou en Ajustes del iPhone, o copia el enlace en el ordenador y pégalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'appareil photo pour Coucou dans les Réglages de l'iPhone, ou copiez le lien sur l'ordinateur et collez-le à la place."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a câmera para o Coucou nos Ajustes do iPhone, ou copie o link no computador e cole-o aqui."
          }
        }
      }
    },
