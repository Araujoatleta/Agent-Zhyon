    "No account, no analytics, no ads. Your sessions come straight from your computer, encrypted, on your local network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin analíticas, sin anuncios. Tus sesiones llegan directamente de tu ordenador, cifradas, por tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas d'analytique, pas de pub. Vos sessions viennent directement de votre ordinateur, chiffrées, sur votre réseau local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem análises, sem anúncios. Suas sessões vêm direto do seu computador, criptografadas, pela sua rede local."
          }
        }
      }
    },
    "No account, no analytics, no ads. Your sessions travel through your own private iCloud, encrypted with your keys.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin analíticas, sin anuncios. Tus sesiones viajan por tu propio iCloud privado, cifradas con tus claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas d'analytique, pas de pub. Vos sessions passent par votre propre iCloud privé, chiffrées avec vos clés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem análises, sem anúncios. Suas sessões passam pelo seu próprio iCloud privado, criptografadas com as suas chaves."
