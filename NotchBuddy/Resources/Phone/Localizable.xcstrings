    "A background task finished": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea en segundo plano terminó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche de fond est terminée"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa em segundo plano terminou"
          }
        }
      }
    },
    "A permission": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma permissão"
          }
        }
      }
    },
    "A question for you": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pregunta para ti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une question pour vous"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pergunta para você"
          }
        }
      }
    },
    "AXYON asks the first time it needs each one. Messages, e-mails and calls always wait for your tap.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON lo pide la primera vez que necesita cada uno. Los mensajes, correos y llamadas siempre esperan tu toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON demande la première fois qu'il en a besoin. Messages, e-mails et appels attendent toujours votre geste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AXYON pede na primeira vez que precisa de cada um. Mensagens, e-mails e ligações sempre esperam o seu toque."
          }
        }
      }
    },
    "AXYON looks for Samsung TVs, Android devices with network debugging on, and Home Assistant. iOS asks once to let it use the local network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON busca televisores Samsung, dispositivos Android con la depuración de red activada y Home Assistant. iOS pide una vez permiso para usar la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON cherche les téléviseurs Samsung, les appareils Android avec le débogage réseau activé et Home Assistant. iOS demande une fois de le laisser utiliser le réseau local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AXYON procura TVs Samsung, aparelhos Android com a depuração de rede ligada e o Home Assistant. O iOS pede uma vez para deixá-lo usar a rede local."
          }
        }
      }
    },
    "AXYON works on its own. Pair a computer to reach it too.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON funciona solo. Empareja un ordenador para llegar también a él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON fonctionne tout seul. Jumelez un ordinateur pour l'atteindre aussi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AXYON funciona sozinho. Pareie um computador para alcançá-lo também."
          }
        }
      }
    },
    "AXYON works without one. A paired computer adds its own home, agents and chat, at home or through Tailscale.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON funciona sin ordenador. Uno emparejado añade su casa, sus agentes y su chat, en casa o a través de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON fonctionne sans ordinateur. Un ordinateur jumelé ajoute sa maison, ses agents et son chat, à la maison ou via Tailscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AXYON funciona sem computador. Um computador pareado acrescenta a casa, os agentes e o chat dele, em casa ou pelo Tailscale."
          }
        }
      }
    },
    "AXYON's brain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cerebro de AXYON"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cerveau d'AXYON"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cérebro do AXYON"
          }
        }
      }
    },
