    "Approvals and questions always notify you. Mochi's sounds are the ones he makes in your Mac's notch.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aprobaciones y las preguntas siempre te avisan. Los sonidos de Mochi son los que hace en el notch de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations et les questions vous notifient toujours. Les sons de Mochi sont ceux qu'il fait dans l'encoche de votre Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovações e perguntas sempre notificam você. Os sons do Mochi são os que ele faz no notch do seu Mac."
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        },
