    "Away from home, %@ can be reached through Tailscale (free): install it on the computer and on this iPhone with the same account, then open this app once at home.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuera de casa, %@ se alcanza por Tailscale (gratis): instálalo en el ordenador y en este iPhone con la misma cuenta, y abre esta app una vez en casa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors de chez vous, %@ se joint par Tailscale (gratuit) : installez-le sur l'ordinateur et sur cet iPhone avec le même compte, puis ouvrez cette app une fois à la maison."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fora de casa, %@ é alcançado pelo Tailscale (grátis): instale no computador e neste iPhone com a mesma conta, depois abra este app uma vez em casa."
          }
        }
      }
    },
