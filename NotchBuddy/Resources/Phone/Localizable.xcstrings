    "AXYON Core summarizes it when it is running; what the code found is below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON Core lo resume cuando esté en marcha; lo que encontró el código está abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AXYON Core le résume quand il tourne ; ce que le code a trouvé est ci-dessous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AXYON Core resume quando estiver rodando; o que o código encontrou está abaixo."
