    "Tap Scan the pairing code below and point the camera at the computer's screen. Or copy the link on the computer and paste it here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escanear el código de vinculación abajo y apunta la cámara a la pantalla del ordenador. O copia el enlace en el ordenador y pégalo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Scanner le code de jumelage ci-dessous et pointez l'appareil photo vers l'écran de l'ordinateur. Ou copiez le lien sur l'ordinateur et collez-le ici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Escanear o código de pareamento abaixo e aponte a câmera para a tela do computador. Ou copie o link no computador e cole aqui."
          }
        }
      }
    },
    "Tell Claude what to do next…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Claude qué hacer ahora…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à Claude quoi faire ensuite…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga ao Claude o que fazer agora…"
          }
        }
      }
    },
    "Terms": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Términos"
