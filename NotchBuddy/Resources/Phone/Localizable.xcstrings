          }
        }
      }
    },
    "Activity · %lld/%lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad · %lld/%lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activité · %lld/%lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividade · %lld/%lld"
          }
        }
      }
    },
    "Add its key in Coucou's Settings on your Mac and keep the iPhone switch on (Settings → General → iPhone). What the Mac sees shows up here: no key is stored on your iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade su clave en la Configuración de Coucou en tu Mac y mantén activada la opción del iPhone (Configuración → General → iPhone). Lo que ve el Mac aparece aquí: ninguna clave se guarda en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez sa clé dans les Réglages de Coucou sur votre Mac et gardez l'option iPhone activée (Réglages → Général → iPhone). Ce que voit le Mac apparaît ici : aucune clé n'est stockée sur votre iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a chave dele nas Configurações do Coucou no seu Mac e mantenha a opção do iPhone ativada (Configurações → Geral → iPhone). O que o Mac vê aparece aqui: nenhuma chave fica guardada no seu iPhone."
          }
        }
      }
    },
    "Add its key on the computer first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade primero su clave en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord sa clé sur l'ordinateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro a chave dele no computador."
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
