    "Another action is still running. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra acción sigue en curso. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre action est encore en cours. Réessayez dans un instant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra ação ainda está em andamento. Tente de novo em instantes."
          }
        }
      }
    },
    "Another brain asks Face ID first. Keys stay on the computer: add one there, in Coucou → Settings → Hermes Agent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de cerebro pide Face ID antes. Las claves se quedan en el ordenador: añade una allí, en Coucou → Configuración → Hermes Agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de cerveau demande d'abord Face ID. Les clés restent sur l'ordinateur : ajoutez-en une là-bas, dans Coucou → Réglages → Hermes Agent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar de cérebro pede o Face ID antes. As chaves ficam no computador: adicione uma lá, em Coucou → Configurações → Hermes Agent."
          }
        }
      }
    },
    "Answer Claude Code's questions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder a las preguntas de Claude Code"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre aux questions de Claude Code"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder às perguntas do Claude Code"
          }
        }
      }
    },
    "Answer on %@. This request can't be answered from the iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde en %@. Esta solicitud no se puede responder desde el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez sur %@. Cette demande ne peut pas être traitée depuis l'iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda em %@. Este pedido não pode ser respondido pelo iPhone."
          }
        }
      }
    },
    "Answer on %@: this question can't be answered from the iPhone.": {
      "localizations": {
