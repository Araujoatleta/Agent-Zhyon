    "Sign in to iCloud with the same Apple Account on both. Your sessions go through your private iCloud, encrypted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud con la misma cuenta de Apple en ambos. Tus sesiones pasan por tu iCloud privado, cifradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud avec le même compte Apple sur les deux. Vos sessions passent par votre iCloud privé, chiffrées."
