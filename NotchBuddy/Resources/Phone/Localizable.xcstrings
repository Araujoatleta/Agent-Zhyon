    "Ask AXYON in the chat to turn a device on or off. With a computer paired, its home shows here too, at home or through Tailscale.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídele a AXYON en el chat que encienda o apague un aparato. Con un ordenador emparejado, su casa también aparece aquí, en casa o a través de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à AXYON dans le chat d'allumer ou d'éteindre un appareil. Avec un ordinateur jumelé, sa maison s'affiche ici aussi, à la maison ou via Tailscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça no chat para o AXYON ligar ou desligar um aparelho. Com um computador pareado, a casa dele aparece aqui também, em casa ou pelo Tailscale."
          }
        }
      }
    },
