            "value": "Termos"
          }
        }
      }
    },
    "The Home Screen icon follows your choice; dark and tinted icons follow the Home Screen style. Spotlight's index stays on this iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de la pantalla de inicio sigue tu elección; los iconos oscuros y tintados siguen el estilo de la pantalla de inicio. El índice de Spotlight se queda en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icône de l'écran d'accueil suit votre choix ; les icônes sombres et teintées suivent le style de l'écran d'accueil. L'index de Spotlight reste sur cet iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone da Tela de Início segue a sua escolha; os ícones escuros e coloridos seguem o estilo da Tela de Início. O índice do Spotlight fica neste iPhone."
          }
        }
      }
    },
    "The agent asks for a permission.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente pide un permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent demande une autorisation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente pede uma permissão."
          }
        }
      }
    },
    "The chat is off on %@: Settings → Phone → \"Let the phone chat with my AI providers\".": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat está desactivado en %@: Configuración → Teléfono → “Permitir que el teléfono chatee con mis proveedores de IA”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discussion est désactivée sur %@ : Réglages → Téléphone → « Laisser le téléphone discuter avec mes fournisseurs d'IA »."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat está desativado em %@: Configurações → Celular → “Permitir que o celular converse com meus provedores de IA”."
          }
        }
      }
    },
    "The code expired: cancel and start again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código caducó: cancela y empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré : annulez et recommencez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código expirou: cancele e comece de novo."
          }
        }
      }
    },
    "The computer can't take this change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador no puede aceptar este cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinateur ne peut pas accepter ce changement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não aceita esta mudança."
          }
        }
      }
    },
    "The computer listed no brain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador no indicó ningún cerebro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinateur n'a indiqué aucun cerveau."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não listou nenhum cérebro."
          }
        }
      }
    },
    "The computer no longer has this change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ordenador ya no tiene este cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordinateur n'a plus ce changement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O computador não tem mais esta alteração."
          }
        }
      }
    },
    "The device can't do this.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo no puede hacer esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil ne sait pas faire cela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aparelho não consegue fazer isso."
          }
        }
      }
    },
    "The sign-in didn't work.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no funcionó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n'a pas abouti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login não deu certo."
          }
        }
      }
    },
    "Then, from here": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, desde aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, d'ici"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, daqui"
          }
        }
      }
    },
    "This QR code isn't a Coucou pairing code. Use the one in Settings → Phone (Android and iPhone) on the computer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código QR no es un código de vinculación de Coucou. Usa el de Configuración → Teléfono (Android y iPhone) en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce QR code n'est pas un code de jumelage Coucou. Utilisez celui de Réglages → Téléphone (Android et iPhone) sur l'ordinateur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este QR code não é um código de pareamento do Coucou. Use o de Configurações → Celular (Android e iPhone) no computador."
          }
        }
      }
    },
    "This command is longer than what reached the iPhone: deny it here, or answer it on %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando es más largo de lo que llegó al iPhone: deniégalo aquí o respóndelo en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette commande est plus longue que ce qui est arrivé sur l'iPhone : refusez-la ici, ou répondez sur %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este comando é maior do que o que chegou ao iPhone: negue aqui ou responda em %@."
          }
        }
      }
    },
    "This device isn't shared with the phone any more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya no se comparte con el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'est plus partagé avec le téléphone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não está mais compartilhado com o celular."
          }
        }
      }
    },
    "This device or routine isn't shared with the phone any more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo o rutina ya no se comparte con el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ou cette routine n'est plus partagé avec le téléphone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho ou rotina não está mais compartilhado com o celular."
          }
        }
      }
    },
    "This iPhone will show the agents running on it and answer their permission requests, on your local network only. Allow always asks for Face ID.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone mostrará los agentes que se ejecutan en él y responderá a sus solicitudes de permiso, solo en tu red local. Permitir siempre pide Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone affichera les agents qui y tournent et répondra à leurs demandes d'autorisation, sur votre réseau local uniquement. Autoriser demande toujours Face ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone vai mostrar os agentes que rodam nele e responder aos pedidos de permissão deles, só na sua rede local. Permitir sempre pede Face ID."
          }
        }
      }
    },
    "This isn't a Coucou pairing link. It starts with coucou://pair?v=1": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es un enlace de vinculación de Coucou. Empieza por coucou://pair?v=1"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un lien de jumelage Coucou. Il commence par coucou://pair?v=1"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não é um link de pareamento do Coucou. Ele começa com coucou://pair?v=1"
          }
        }
      }
    },
    "This request was already answered or has expired.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud ya se respondió o caducó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande a déjà reçu une réponse ou a expiré."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido já foi respondido ou expirou."
          }
        }
      }
    },
    "This session ended on your Mac. Its last turn:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión terminó en tu Mac. Su último turno:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session s'est terminée sur votre Mac. Son dernier tour :"
