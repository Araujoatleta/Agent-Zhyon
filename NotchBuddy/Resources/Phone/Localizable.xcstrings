      }
    },
    "Coucou doesn't run Hermes on %@: turn on “Coucou runs Hermes” below to change its brain and skills from here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou no ejecuta Hermes en %@: activa “Coucou ejecuta Hermes” abajo para cambiar su cerebro y sus habilidades desde aquí."
          }
        },
        "fr": {
